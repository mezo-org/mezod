# hadolint global ignore=DL3018
#
# The upstream Blockscout frontend build on Node 22. The upstream image runs
# it on Node 20, so this image copies /app unchanged and repeats the packages,
# user and entrypoint of the upstream runtime stage.
FROM ghcr.io/blockscout/frontend:v1.33.1@sha256:d26db884b06afce3722510dace4333043a9f97ffcfc82887afd03a533ac40c78 AS upstream

FROM node:22.23.4-alpine

RUN apk --no-cache upgrade && apk --no-cache add bash curl jq unzip

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

WORKDIR /app

COPY --from=upstream /app /app

ENV ENVS_PRESET=
ENV PORT=3000

USER 1001:1001

EXPOSE 3000

ENTRYPOINT ["./entrypoint.sh"]

CMD ["node", "server.js"]
