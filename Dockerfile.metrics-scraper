# hadolint global ignore=DL3018
FROM --platform=$BUILDPLATFORM golang:1.26.10-alpine AS builder

ARG TARGETOS TARGETARCH

WORKDIR /app
COPY . .

RUN go mod download && \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o metrics-scraper ./cmd/metrics-scraper

FROM alpine:3.22

RUN apk --no-cache upgrade && apk --no-cache add ca-certificates tzdata

RUN mkdir -p  /etc/metrics-scraper

WORKDIR /

COPY --from=builder /app/metrics-scraper .

ENTRYPOINT ["./metrics-scraper"]
